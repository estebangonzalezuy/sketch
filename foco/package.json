{
  "name": "foco",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Foco: bloqueador de distracciones para la barra de menú de macOS. Tauri 2 (Rust) + React + DialKit.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "helper": "node scripts/build-helper.mjs",
    "tauri": "tauri",
    "app": "tauri build --bundles app",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml -p foco-core -p foco-helper"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "dialkit": "^2.2.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
