{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Foco",
  "mainBinaryName": "foco",
  "version": "0.2.0",
  "identifier": "co.estebangonzalez.foco",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run helper && npm run dev",
    "beforeBuildCommand": "npm run helper -- --release && npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/foco-helper"],
    "resources": ["resources/install-helper.sh", "resources/uninstall-helper.sh"],
    "macOS": { "minimumSystemVersion": "14.0", "signingIdentity": "-" }
  }
}
