{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "destination": "/sketches",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/sketches/motion-studios-index/((?!assets/|og/|fonts/).*)",
      "destination": "/sketches/motion-studios-index/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sketches/:sketch/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
